# A CRLF checkout breaks shebangs and `set -euo` inside the Linux container.
*.sh text eol=lf

# ruff format enforces LF; a CRLF checkout would flag every file.
*.py text eol=lf

# *.md, *.tex and *.yml stay unpinned: several are stored CRLF and pinning rewrites whole files.

# Binary assets: never apply text conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.pptx binary
*.otf  binary
*.ttf  binary
