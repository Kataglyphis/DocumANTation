data/out/

# Python cache artifacts
__pycache__/
*.pyc

# Virtualenv. uv writes a self-ignoring .venv/.gitignore, so this is belt and
# braces -- but a venv created any other way (python -m venv, virtualenv) does
# not, and 5000+ site-packages files then show up as untracked.
.venv/
venv/

# Python packaging / editable-install artifacts
# (`pip install -e sphinx-kataglyphis-theme` generates these)
*.egg-info/
.eggs/
build/
dist/

# Test / coverage artifacts
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/

# LaTeX build artifacts
*.aux
*.log
*.fls
*.fdb_latexmk
*.ind
*.bbl
*.blg
*.bcf
*.run.xml
*.out
*.toc
*.nav
*.snm
*.vrb
*.glo
*.gls
*.glg
*.nlo
*.nls
*.ilg

# The CV now builds into data/out/ with the other documents, so it needs no
# rule of its own -- data/out/ at the top of this file already covers it.

# Sphinx build output
docs/_build/
