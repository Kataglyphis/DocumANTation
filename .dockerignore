# The image needs only pyproject.toml, uv.lock and the theme submodules; keep the context small.
.git
.github
.venv
**/__pycache__
**/*.pyc
.ruff_cache
.pytest_cache

# Build outputs / generated PDFs and logs
data/out/
data/cv/*.pdf
docs/_build/
*.log

# Docs, tests and tooling not used by the image build
docs/
tests/
images/
.vscode/
